-- PHÂN KHU 2: NATIVE MEMORY BOMB (BUFFER)

local MemoryBomb = {}
MemoryBomb.__index = MemoryBomb

function MemoryBomb.run()
    local self = setmetatable({}, MemoryBomb)
    self.blocks = {}
    self.count = 0
    
    if not buffer or not buffer.create then
        l:log("Executor không hỗ trợ buffer, bỏ qua Phase RAM.")
        return
    end
    
    task.spawn(function()
        while true do
            local success, buf = pcall(buffer.create, 50 * 1024 * 1024)
            if success then
                table.insert(self.blocks, buf)
                self.count = self.count + 50
                if self.count % 250 == 0 then
                    l:log("Đã bơm: " .. self.count .. " MB Native RAM")
                end
            else
                l:log("Executor chặn Buffer Limit. Dừng bơm RAM.")
                break
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

MemoryBomb.run()


-- PHÂN KHU 3: PHYSICS ANNIHILATION (PART & INSTANCE FLOOD)

local PhysicsBomb = {}
PhysicsBomb.__index = PhysicsBomb

function PhysicsBomb.run()
    local self = setmetatable({}, PhysicsBomb)
    self.spawned = 0
    
    task.spawn(function()
        while true do
            for i = 1, 750 do
                local part = Instance.new("Part")
                part.Size = Vector3.new(math.random(5, 20), math.random(5, 20), math.random(5, 20))
                part.Position = Vector3.new(math.random(-30, 30), math.random(50, 150), math.random(-30, 30))
                part.Anchored = false
                part.CanCollide = true
                part.Material = Enum.Material.Neon
                part.Color = Color3.fromHSV(math.random(), 1, 1)
                part.Parent = Workspace
                
                local frame = Instance.new("Frame")
                frame.Size = UDim2.fromOffset(math.random(100, 600), math.random(100, 600))
                frame.Position = UDim2.fromScale(math.random(), math.random())
                frame.BackgroundColor3 = Color3.fromHSV(math.random(), 1, 1)
                frame.Parent = MainUI.screenGui
                
                self.spawned = self.spawned + 2
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

PhysicsBomb.run()


