function Logger.new(prefix)
    local self = setmetatable({}, Logger)
    self.prefix = prefix
    return self
end

function Logger:log(msg)
    warn(string.format("[%s] %s", self.prefix, msg))
    print(string.format("[%s] %s", self.prefix, msg))
end

