-- Buffer Bomb: 100MB mỗi lần, dùng Heartbeat để đồng bộ chính xác
task.spawn(function()
    local memory_blocks = {}
    local count = 0
    while true do
        local success, buf = pcall(buffer.create, 100 * 1024 * 1024) -- 100MB
        if success then
            table.insert(memory_blocks, buf)
            count = count + 100
            if count % 500 == 0 then log("Native RAM bơm: " .. count .. " MB") end
        else
            log("Buffer limit hit hoặc executor chặn cấp phát!")
            break -- Bể rồi thì thôi
        end
        RunService.Heartbeat:Wait() -- Yield đúng chuẩn frame engine
    end
end)

