-- Logic ESP Toggle
EspToggleBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    if espEnabled then
        EspToggleBtn.BackgroundColor3 = COLORS.Success
        EspToggleBtn.TextColor3 = COLORS.TextPrimary
        EspToggleBtn.Text = "ON"
    else
        EspToggleBtn.BackgroundColor3 = COLORS.Border
        EspToggleBtn.TextColor3 = COLORS.TextSecondary
        EspToggleBtn.Text = "OFF"
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character then
                local hl = player.Character:FindFirstChild("ZenkaPanelESP")
                if hl then hl:Destroy() end
            end
        end
    end
end)

-- Vòng lặp tối ưu cập nhật WalkSpeed, Hitbox & ESP
RunService.RenderStepped:Connect(function()
    -- Cập nhật WalkSpeed cho LocalPlayer
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            hum.WalkSpeed = currentWalkSpeed
        end
    end

    -- Cập nhật Hitbox và ESP cho những người chơi khác
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if root and hum and hum.Health > 0 then
                if currentHitboxSize > 0 then
                    root.Size = Vector3.new(2, 2, 1) * (1 + currentHitboxSize * 0.35)
                    root.Transparency = 0.6
                    root.CanCollide = false
                else
                    root.Size = Vector3.new(2, 2, 1)
                    root.Transparency = 1
                end
            end

            if espEnabled then
                if hum and hum.Health > 0 then
                    local hl = char:FindFirstChild("ZenkaPanelESP")
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "ZenkaPanelESP"
                        hl.Adornee = char
                        hl.Parent = char
                        hl.FillColor = COLORS.Accent
                        hl.OutlineColor = COLORS.TextPrimary
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                    end
                else
                    local hl = char:FindFirstChild("ZenkaPanelESP")
                    if hl then hl:Destroy() end
                end
            else
                local hl = char:FindFirstChild("ZenkaPanelESP")
                if hl then hl:Destroy() end
            end
        end
    end
end)
