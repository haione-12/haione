-- Logic Chuyển Tab Mượt Mà
local currentTab = "Home"
for name, btn in pairs(tabButtons) do
    btn.MouseButton1Click:Connect(function()
        if currentTab == name then return end
        currentTab = name
        
        for tName, page in pairs(tabPages) do
            local targetBtn = tabButtons[tName]
            if tName == name then
                page.Visible = true
                TweenService:Create(targetBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0, BackgroundColor3 = COLORS.Card}):Play()
                targetBtn.TextColor3 = COLORS.TextPrimary
            else
                page.Visible = false
                TweenService:Create(targetBtn, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
                targetBtn.TextColor3 = COLORS.TextSecondary
            end
        end
    end)
end

-- Biến Trạng Thái Chức Năng
local draggingMain = false
local draggingSliderHb = false
local draggingSliderWs = false
local dragStart, startPos

local currentHitboxSize = 0
local currentWalkSpeed = 16
local espEnabled = false

-- Logic Kéo Cửa Sổ (Drag Main Frame)
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingMain = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

-- Logic Cập Nhật Hitbox Slider (0-100)
local function updateHitboxSlider(input)
    local absolutePos = SliderBg.AbsolutePosition.X
    local absoluteSize = SliderBg.AbsoluteSize.X
    local relativeX = math.clamp(input.Position.X - absolutePos, 0, absoluteSize)
    local percentage = relativeX / absoluteSize
    
    SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    SliderKnob.Position = UDim2.new(percentage, -6, 0.5, -6)
    
    currentHitboxSize = math.floor(percentage * 100)
    hbValueLabel.Text = "Size: " .. currentHitboxSize
end

SliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSliderHb = true
        updateHitboxSlider(input)
    end
end)

SliderKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSliderHb = true
    end
end)

-- Logic Cập Nhật WalkSpeed Slider (0-1000)
local function updateWalkSpeedSlider(input)
    local absolutePos = WsSliderBg.AbsolutePosition.X
    local absoluteSize = WsSliderBg.AbsoluteSize.X
    local relativeX = math.clamp(input.Position.X - absolutePos, 0, absoluteSize)
    local percentage = relativeX / absoluteSize
    
    WsSliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    WsSliderKnob.Position = UDim2.new(percentage, -6, 0.5, -6)
    
    currentWalkSpeed = math.floor(percentage * 1000)
    wsValueLabel.Text = "Speed: " .. currentWalkSpeed
end

WsSliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSliderWs = true
        updateWalkSpeedSlider(input)
    end
end)

WsSliderKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSliderWs = true
    end
end)

-- Xử lý kết thúc tương tác cảm ứng/chuột chung
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSliderHb = false
        draggingSliderWs = false
        draggingMain = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if draggingSliderHb then
            updateHitboxSlider(input)
        elseif draggingSliderWs then
            updateWalkSpeedSlider(input)
        elseif draggingMain then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end
end)

