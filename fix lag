----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local current_level = 0          -- 0 = off, 1..4 = fix lag levels
local running = true             -- master kill flag
local cache = {}                 -- cache[instance] = { [propName] = oldValue }
local connections = {}           -- all event connections, disconnected on shutdown

local function track_conn(c)
	table.insert(connections, c)
end

local function disconnect_all()
	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	connections = {}
end

----------------------------------------------------------------
-- CACHE / RESTORE
----------------------------------------------------------------
local function cache_prop(inst, prop, value)
	cache[inst] = cache[inst] or {}
	if cache[inst][prop] == nil then
		cache[inst][prop] = value
	end
end

local function set_prop(inst, prop, newValue)
	local ok, oldValue = pcall(function() return inst[prop] end)
	if not ok then return end
	cache_prop(inst, prop, oldValue)
	pcall(function() inst[prop] = newValue end)
end

local function restore_all()
	for inst, props in pairs(cache) do
		if inst and inst.Parent then
			for prop, value in pairs(props) do
				pcall(function() inst[prop] = value end)
			end
		end
	end
	cache = {}
	current_level = 0
end

----------------------------------------------------------------
-- LEVEL APPLICATION (per-instance, called on existing + new descendants)
----------------------------------------------------------------
local EFFECT_CLASSES_L1 = {
	ParticleEmitter = true, Trail = true, Beam = true,
	Smoke = true, Fire = true, Sparkles = true,
}
local LIGHT_CLASSES_L2 = {
	PointLight = true, SpotLight = true, SurfaceLight = true,
}
local POSTFX_CLASSES_L2 = {
	BloomEffect = true, BlurEffect = true, SunRaysEffect = true,
	ColorCorrectionEffect = true, DepthOfFieldEffect = true,
}

-- skip list: don't touch NPC/Hitbox/Terrain/gameplay UI
local function is_protected(inst)
	if inst:IsA("Terrain") then return true end
	local n = inst.Name:lower()
	if n:find("hitbox") or n:find("npc") then return true end
	local model = inst:FindFirstAncestorOfClass("Model")
	if model and (model:FindFirstChild("Humanoid")) then
		-- part of an NPC/character rig -> skip material changes, but effects still ok to disable
		return "character"
	end
	return false
end

local function apply_level1_instance(inst)
	if EFFECT_CLASSES_L1[inst.ClassName] then
		set_prop(inst, "Enabled", false)
	end
end

local function apply_level2_instance(inst)
	if LIGHT_CLASSES_L2[inst.ClassName] then
		set_prop(inst, "Enabled", false)
	end
end

local function apply_level3_instance(inst)
	if inst:IsA("BasePart") then
		local protected = is_protected(inst)
		if protected ~= true and protected ~= "character" then
			if inst.Material ~= Enum.Material.SmoothPlastic and inst.Material ~= Enum.Material.Plastic then
				set_prop(inst, "Material", Enum.Material.SmoothPlastic)
			end
		end
	end
end

local function apply_level4_instance(inst)
	if inst:IsA("Decal") or inst:IsA("Texture") then
		local protected = is_protected(inst)
		if protected ~= true and protected ~= "character" then
			set_prop(inst, "Transparency", 1)
		end
	end
end

-- dispatch: apply all levels up to current_level to one instance
local function apply_current_level_to_instance(inst)
	if current_level >= 1 then apply_level1_instance(inst) end
	if current_level >= 2 then apply_level2_instance(inst) end
	if current_level >= 3 then apply_level3_instance(inst) end
	if current_level >= 4 then apply_level4_instance(inst) end
end

----------------------------------------------------------------
-- LIGHTING / WORKSPACE / TERRAIN GLOBAL SETTINGS PER LEVEL
----------------------------------------------------------------
local function apply_level2_lighting()
	for _, inst in ipairs(Lighting:GetChildren()) do
		if POSTFX_CLASSES_L2[inst.ClassName] then
			set_prop(inst, "Enabled", false)
		end
	end
end

local function apply_level3_global()
	set_prop(Lighting, "GlobalShadows", false)
	set_prop(Lighting, "FogStart", 0)
	set_prop(Lighting, "FogEnd", 300)
end

local function apply_level4_global()
	pcall(function()
		if Workspace.StreamingEnabled then
			set_prop(Workspace, "StreamingTargetRadius", 128)
		end
	end)
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		set_prop(terrain, "WaterWaves", 0)
		set_prop(terrain, "WaterReflectance", 0)
	end
end

----------------------------------------------------------------
-- FULL SWEEP (on level change) + NEW-INSTANCE HOOK
----------------------------------------------------------------
local function sweep_apply(level)
	current_level = level
	for _, inst in ipairs(Workspace:GetDescendants()) do
		apply_current_level_to_instance(inst)
	end
	if level >= 2 then apply_level2_lighting() end
	if level >= 3 then apply_level3_global() end
	if level >= 4 then apply_level4_global() end
end

local function set_level(level)
	if level == 0 then
		restore_all()
		return
	end
	-- restore first so stepping down (e.g. x3 -> x1) reverts higher-tier changes
	restore_all()
	sweep_apply(level)
end

local function hook_new_descendants()
	track_conn(game.DescendantAdded:Connect(function(inst)
		if not running then return end
		if current_level >= 1 and inst:IsDescendantOf(Workspace) then
			apply_current_level_to_instance(inst)
		end
	end))
end

